# Mangalyam — every variable the app reads. Copy to .env for local work, or
# paste into Coolify's environment panel for a deploy.
#
# Nothing here has a safe default that guesses: an unset price stops checkout
# loudly, an unset admin list means nobody is an admin, and an unset S3
# bucket fails the first upload rather than silently dropping a file.

# ---- database ----
# Coolify's own Postgres service gives you this string. On the same Docker
# network use the service name as the host, not localhost.
DATABASE_URL="postgresql://mangalyam:CHANGE_ME@postgres:5432/mangalyam"

# ---- auth ----
# Generate once, keep it secret, never rotate casually — changing it signs
# every customer out. `openssl rand -base64 32`
AUTH_SECRET="CHANGE_ME"
# Auth.js refuses to run behind a proxy it was not told about; Coolify is one.
AUTH_TRUST_HOST=true
# The canonical public origin, no trailing slash.
AUTH_URL="https://mangalyam.my"

# ---- public (inlined into the browser bundle at BUILD time) ----
# These must be set as build arguments too, not only at runtime — Next bakes
# NEXT_PUBLIC_* into the client bundle when it builds.
NEXT_PUBLIC_APP_URL="https://mangalyam.my"
# International format, digits only. Used by the custom-quote button.
NEXT_PUBLIC_CONTACT_WHATSAPP="60123456789"

# ---- pricing ----
# Sen, not ringgit: 4900 is RM 49. Must be a positive integer, or checkout
# refuses to run and the landing page shows "Price to be confirmed".
PRICE_STANDARD_SEN="4900"
PAYMENT_CURRENCY="myr"

# ---- admin ----
# Comma-separated. Empty or unset means nobody is an admin — never everybody.
# Changing this is a deploy, which is the point: no row in the database grants
# admin, so no bug in signup can escalate anyone.
ADMIN_EMAILS="you@mangalyam.my"

# ---- object storage (MinIO on the same box) ----
# S3_ENDPOINT is how the *app container* reaches MinIO — a service name on the
# Docker network. S3_PUBLIC_URL is how a *guest's phone* reaches it, which is
# a real hostname over TLS. These are almost never the same value, and mixing
# them up is the usual reason uploads succeed but images 404.
S3_ENDPOINT="http://minio:9000"
S3_PUBLIC_URL="https://cdn.mangalyam.my"
S3_BUCKET="mangalyam"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"
S3_REGION="us-east-1"

# ---- payments (optional until you sell) ----
# Leave unset while PRICE_STANDARD_SEN is unset; checkout is hidden anyway.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
