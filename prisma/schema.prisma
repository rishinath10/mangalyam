// Mangalyam — PostgreSQL schema (CLAUDE.md Section 4.2)
//
// Structural rule #1: `events` is the top-level owned/billed entity.
// `invitations` (one per occasion, or one per ceremony for a wedding) hang
// off an event, never the reverse.
//
// There is no RLS here. Every route touching an event-owned row must call the
// ownership guards in lib/auth/ownership.ts explicitly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * The occasion an Event celebrates. "Mangalyam" means auspicious, not
 * wedding — the product covers the Malaysian Indian celebration calendar, not
 * only weddings. Only `wedding` events carry sub-ceremonies (CeremonyType);
 * every other type gets exactly one Invitation with no ceremony of its own.
 */
enum EventType {
  wedding
  naming_ceremony
  housewarming
  sixtieth_birthday
  temple_consecration
  home_pooja
  community_event
  custom
}

enum PurchaseStatus {
  pending
  paid
  failed
  refunded
}

/** Sub-ceremonies within a wedding. Meaningless for any other EventType. */
enum CeremonyType {
  mehendi
  haldi
  sangeet
  // Muhurtham is the main ceremony for Tamil families and Nalangu is a
  // fixture; baraat is kept for families who hold one.
  muhurtham
  nalangu
  baraat
  reception
  engagement
  custom
}

enum InvitationStatus {
  draft
  published
}

/**
 * How the cover opens before the invitation is revealed.
 *
 * `doors` is the temple-door swing, `envelope` folds a flap back, `veil`
 * lifts a soft blur. The renderer maps each to one animation; adding a value
 * here without a case there falls back to `doors` rather than showing nothing.
 */
enum OpeningStyle {
  doors
  envelope
  veil
}

enum DesignSystem {
  temple_heritage
  kolam_classic
  kalash_royal
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  createdAt    DateTime  @default(now()) @map("created_at")

  events       Event[]

  @@map("users")
}

model Event {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // A flexible display string rather than a couple pair — "Rishi & Gaayathri"
  // for a wedding, "The Kumar Family" for a housewarming, one name for a
  // solo celebrant. Templates render it as-is; only a wedding's own template
  // family looks for an "&" to style two names specially.
  hostNames String    @map("host_names")
  eventType EventType @map("event_type")
  createdAt DateTime  @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases   Purchase[]
  entitlement Entitlement?
  invitations Invitation[]

  @@index([userId])
  @@map("events")
}

model Purchase {
  id                String         @id @default(uuid()) @db.Uuid
  eventId           String         @map("event_id") @db.Uuid
  // Amounts are stored in sen (MYR minor units) to avoid float rounding.
  // One flat self-serve price — nothing in this codebase may hardcode it.
  amountSen         Int            @map("amount_sen")
  paymentGatewayRef String?        @map("payment_gateway_ref")
  status            PurchaseStatus @default(pending)
  createdAt         DateTime       @default(now()) @map("created_at")

  event             Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("purchases")
}

model Entitlement {
  id              String @id @default(uuid()) @db.Uuid
  eventId         String @unique @map("event_id") @db.Uuid
  // Self-serve is always exactly one invitation (CLAUDE.md Section 8): there
  // are no public tiers or bundles. A second invitation, or anything else, is
  // a custom quote handled outside this table entirely.
  invitationLimit Int    @map("invitation_limit")

  event           Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}

model Invitation {
  id                  String           @id @default(uuid()) @db.Uuid
  eventId             String           @map("event_id") @db.Uuid
  slug                String           @unique
  // Null for every EventType except `wedding`, which alone has sub-ceremonies.
  ceremonyType        CeremonyType?    @map("ceremony_type")
  customCeremonyName  String?          @map("custom_ceremony_name")
  templateId          String           @map("template_id")
  accentColorOverride String?          @map("accent_color_override")
  status              InvitationStatus @default(draft)
  date                DateTime?        @db.Date
  startTime           String?          @map("start_time")
  endTime             String?          @map("end_time")
  venueName           String?          @map("venue_name")
  address             String?
  mapLink             String?          @map("map_link")
  description         String?
  coverPhotoUrl       String?          @map("cover_photo_url")
  publishedAt         DateTime?        @map("published_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  event               Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scheduleItems       InvitationScheduleItem[]
  photos              InvitationPhoto[]
  settings            InvitationSettings?
  rsvps               Rsvp[]

  @@index([eventId])
  @@map("invitations")
}

model InvitationScheduleItem {
  id           String     @id @default(uuid()) @db.Uuid
  invitationId String     @map("invitation_id") @db.Uuid
  time         String
  title        String
  description  String?
  sortOrder    Int        @default(0) @map("sort_order")

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("invitation_schedule_items")
}

model InvitationPhoto {
  id           String     @id @default(uuid()) @db.Uuid
  invitationId String     @map("invitation_id") @db.Uuid
  url          String
  caption      String?
  sortOrder    Int        @default(0) @map("sort_order")

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("invitation_photos")
}

model InvitationSettings {
  invitationId     String     @id @map("invitation_id") @db.Uuid
  musicEnabled     Boolean    @default(false) @map("music_enabled")
  musicUrl         String?    @map("music_url")
  countdownEnabled Boolean    @default(true) @map("countdown_enabled")
  galleryEnabled   Boolean    @default(true) @map("gallery_enabled")
  rsvpEnabled      Boolean    @default(true) @map("rsvp_enabled")
  askMealPreference Boolean   @default(false) @map("ask_meal_preference")
  rsvpCloseDate    DateTime?  @map("rsvp_close_date") @db.Date
  language         String     @default("en")

  // The opening sequence: a tap on the seal reveals the invitation.
  openingStyle     OpeningStyle @default(doors) @map("opening_style")
  /** Caption under the host names on the seal. Null uses "Open". */
  openingText      String?      @map("opening_text")
  /** Drifts the page down after the opening; a guest touch cancels it. */
  autoScroll       Boolean      @default(true) @map("auto_scroll")

  // The person guests call about the occasion, shown in the action bar.
  contactName      String?      @map("contact_name")
  contactPhone     String?      @map("contact_phone")

  invitation       Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("invitation_settings")
}

// Public-insert, owner-only-read (CLAUDE.md rule #4). Reads must go through an
// ownership guard; the public submit route must be rate-limited.
model Rsvp {
  id             String     @id @default(uuid()) @db.Uuid
  invitationId   String     @map("invitation_id") @db.Uuid
  guestName      String     @map("guest_name")
  attending      Boolean
  guestCount     Int        @default(1) @map("guest_count")
  mealPreference String?    @map("meal_preference")
  message        String?
  createdAt      DateTime   @default(now()) @map("created_at")

  invitation     Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("rsvps")
}

model Template {
  id           String       @id
  name         String
  designSystem DesignSystem @map("design_system")
  manifestJson Json         @map("manifest_json")
  previewImage String?      @map("preview_image")
  isActive     Boolean      @default(true) @map("is_active")

  @@map("templates")
}
